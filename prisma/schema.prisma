generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Association {
  id         String   @id @default(uuid())
  name       String
  siret      String?  @unique
  address    String?
  postalCode String?
  city       String?
  email      String?
  phone      String?
  legalFormCode  String?
  legalFormOther String?
  chartTemplateId String?
  chartTemplate   ChartTemplate? @relation(fields: [chartTemplateId], references: [id], onDelete: SetNull)
  /// Subject to French VAT (assujetti à la TVA).
  vatLiable  Boolean  @default(false)
  isClosed   Boolean  @default(false)
  logoRelativePath String?
  logoMimeType     String?
  logoSizeBytes    Int?
  /// RNA (WALDEC), distinct from SIRET.
  rna String?
  socialObject String?
  receiptSignatoryName String?
  receiptSignatoryRole String?
  /// Association attests intérêt général (art. 200 / 238 bis CGI); software does not certify it.
  taxReceiptEligibilityAttested Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fiscalYears   FiscalYear[]
  budgets       Budget[]
  counterparties Counterparty[]
  recurringExpenseTemplates RecurringExpenseTemplate[]
  invoices Invoice[]
  membershipCategories MembershipCategory[]
  membershipSeasons MembershipSeason[]
  members Member[]
  donations Donation[]
  taxReceiptSequences TaxReceiptSequence[]
  taxReceipts TaxReceipt[]
}

// Third parties (suppliers / customers) scoped to the association (UI: Paramètres → Fournisseurs et clients).
model Counterparty {
  id             String      @id @default(uuid())
  associationId  String
  association    Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  // SQLite: use string constants SUPPLIER | CUSTOMER at application layer
  kind           String
  name           String

  entries Entry[]
  recurringExpenseTemplates RecurringExpenseTemplate[]
  invoices Invoice[]
  members Member[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, kind])
}

/// Quick-entry template (UI: dépense courante / modèle de saisie), scoped to association.
model RecurringExpenseTemplate {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  title         String
  operationType String // DEPENSE | RECETTE | TRANSFERT
  /// Null = amount entered at each use (quick-entry scaffold).
  amountCents   Int?

  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)

  operationAccountNumber String
  treasuryAccountNumber  String?
  /// Preset pack code (e.g. CORE_ASSOCIATION); null = user-created template.
  packCode               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, title])
  @@unique([associationId, title, operationType])
}

model Budget {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  name  String
  notes String?

  // Reference snapshot (informational only) when prefilled
  sourceFiscalYearId       String?
  sourceCoefficientPercent Int? // ex: 110 = +10%

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BudgetLine[]

  @@index([associationId, updatedAt])
}

model BudgetLine {
  id       String @id @default(uuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  accountNumber String
  accountName   String
  amountCents   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([budgetId, accountNumber])
  @@index([budgetId])
}

model ChartTemplate {
  id        String   @id @default(uuid())
  code      String   @unique // ex: ASSOCIATION, TPE
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  ChartTemplateAccount[]
  associations Association[]
}

model ChartTemplateAccount {
  id              String        @id @default(uuid())
  chartTemplateId String
  chartTemplate   ChartTemplate @relation(fields: [chartTemplateId], references: [id], onDelete: Cascade)

  number    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chartTemplateId, number])
  @@index([chartTemplateId, number])
}

model FiscalYear {
  id            String   @id @default(uuid())
  startDate     DateTime
  endDate       DateTime
  status        String   // "OPEN" or "CLOSED"
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  accounts   Account[]
  entries    Entry[]
  documents  Document[]
  inKindContributions InKindContribution[]
  invoices Invoice[]
  invoiceSequences InvoiceSequence[]
  donations Donation[]

  @@unique([associationId, startDate, endDate])
}

model Journal {
  id      String  @id @default(uuid())
  code    String  @unique // BQ, AC, VE, OD
  name    String
  entries Entry[]
}

model Account {
  id           String     @id @default(uuid())
  number       String
  name         String
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  lines EntryLine[]

  @@unique([number, fiscalYearId])
}

model Entry {
  id              String     @id @default(uuid())
  date            DateTime
  description     String
  journalId       String
  journal         Journal    @relation(fields: [journalId], references: [id])
  fiscalYearId    String
  fiscalYear      FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  lines           EntryLine[]

  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)

  referenceNumber   String?
  referenceSequence Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([fiscalYearId, journalId, date])
  @@index([counterpartyId])
}

model EntryLine {
  id          String  @id @default(uuid())
  entryId     String
  entry       Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountNumber String
  accountName   String

  debitCents  Int @default(0)
  creditCents Int @default(0)

  documents  DocumentEntryLine[]

  // Internal allocation links (e.g. supplier payable 401 credit lines allocated by 401 debit settlements).
  payableAllocations   CounterpartySettlementAllocation[] @relation("PayableLineAllocations")
  settlementAllocations CounterpartySettlementAllocation[] @relation("SettlementLineAllocations")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CounterpartySettlementAllocation {
  id String @id @default(uuid())

  // 401/411 line representing the payable/receivable to be settled (typically credit for 401, debit for 411).
  payableLineId String
  payableLine   EntryLine @relation("PayableLineAllocations", fields: [payableLineId], references: [id], onDelete: Cascade)

  // 401/411 line representing the settlement movement (typically debit for 401, credit for 411).
  settlementLineId String
  settlementLine   EntryLine @relation("SettlementLineAllocations", fields: [settlementLineId], references: [id], onDelete: Cascade)

  amountCents Int

  createdAt DateTime @default(now())

  @@index([payableLineId])
  @@index([settlementLineId])
  @@unique([payableLineId, settlementLineId])
}

model JournalSequence {
  id           String   @id @default(uuid())
  fiscalYearId String
  journalId    String
  nextNumber   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([fiscalYearId, journalId])
  @@index([fiscalYearId])
}

model AuditEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  associationId String?
  fiscalYearId  String?

  actor      String? // no user system yet (ex: associationId, "system")
  action     String  // ex: ENTRY_CREATE, ENTRY_REVERSE, FISCAL_YEAR_CLOSE, DOCUMENT_UPLOAD
  entityType String  // ex: Entry, Document, FiscalYear, Account
  entityId   String?

  data       String? // JSON string (SQLite)

  @@index([associationId, createdAt])
  @@index([fiscalYearId, createdAt])
  @@index([entityType, entityId])
}

model Document {
  id           String   @id @default(uuid())
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  sha256       String?

  relativePath String
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines DocumentEntryLine[]
  inKindContributions InKindContribution[]

  @@index([fiscalYearId, uploadedAt])
  @@unique([fiscalYearId, storedName])
}

model DocumentEntryLine {
  id          String    @id @default(uuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entryLineId String
  entryLine   EntryLine @relation(fields: [entryLineId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([documentId, entryLineId])
  @@index([entryLineId])
  @@index([documentId])
}

model InKindContribution {
  id String @id @default(uuid())

  associationId String
  fiscalYearId  String
  fiscalYear    FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  // SQLite connector in this repo does not support Prisma enums.
  // Values are validated at the application layer.
  kind String

  date DateTime
  description String
  contributorName String?

  quantityMilliUnits Int
  unit String

  unitValueCents  Int?
  totalValueCents Int
  valuationMethod String

  meetsAnc2112Essential Boolean
  meetsAnc2112Measurable Boolean

  isRecorded Boolean
  entryId    String?

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, fiscalYearId, kind, date])
  @@index([fiscalYearId, date])
  @@index([entryId])
  @@index([documentId])
}

model InvoiceSequence {
  id           String     @id @default(uuid())
  fiscalYearId String     @unique
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  nextNumber   Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Invoice {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  fiscalYearId  String
  fiscalYear    FiscalYear  @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  sequence Int
  number   String

  issueDate DateTime
  dueDate   DateTime

  recipientName       String
  recipientAddress    String?
  recipientPostalCode String?
  recipientCity       String?
  recipientEmail      String?
  recipientSiret      String?

  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)

  totalCents Int

  entryId String? @unique
  pdfDocumentId String?

  lines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fiscalYearId, sequence])
  @@index([associationId, issueDate])
  @@index([fiscalYearId, issueDate])
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sortOrder Int
  description String

  quantityMilliUnits Int?
  unitPriceCents     Int?
  amountCents        Int

  accountId     String?
  accountNumber String
  accountName   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, sortOrder])
}

model MembershipCategory {
  id             String      @id @default(uuid())
  associationId  String
  association    Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  name           String
  /// Default template used when copying tariffs onto a new season.
  amountCents    Int
  /// 7561 without counterpart, 7562 with counterpart (ANC 2018-06).
  duesAccountNumber String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]
  seasonTariffs MembershipSeasonTariff[]
  fees    MembershipFee[]

  @@unique([associationId, name])
  @@index([associationId])
}

/// Sporting season (independent from the accounting fiscal year).
model MembershipSeason {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  name          String
  startDate     DateTime
  endDate       DateTime
  /// OPEN | CLOSED — clôture = lecture seule (adhésions, tarifs, encaissements liés).
  status        String      @default("OPEN")
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tariffs MembershipSeasonTariff[]
  fees    MembershipFee[]

  @@unique([associationId, name])
  @@index([associationId, startDate])
}

/// Category tariff for one season (amount and 756 account frozen on the season).
model MembershipSeasonTariff {
  id                String             @id @default(uuid())
  seasonId          String
  season            MembershipSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  categoryId        String
  category          MembershipCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amountCents       Int
  duesAccountNumber String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  fees MembershipFee[]

  @@unique([seasonId, categoryId])
  @@index([categoryId])
}

model Member {
  id             String      @id @default(uuid())
  associationId  String
  association    Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  address        String?
  postalCode     String?
  city           String?
  licenseNumber  String?
  birthDate      DateTime?
  notes          String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  categoryId     String?
  category       MembershipCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fees MembershipFee[]

  @@index([associationId, lastName])
  @@index([categoryId])
  @@index([counterpartyId])
}

/// Season membership (adhésion): identity snapshot, options, and dues for one season tariff.
model MembershipFee {
  id            String     @id @default(uuid())
  associationId String
  memberId      String
  member        Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  seasonId      String
  season        MembershipSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  tariffId      String
  tariff        MembershipSeasonTariff @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  /// Denormalized from tariff (Member.categoryId remains the habitual category).
  categoryId String?
  category   MembershipCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  snapshotFirstName     String
  snapshotLastName      String
  snapshotEmail         String?
  snapshotPhone         String?
  snapshotAddress       String?
  snapshotPostalCode    String?
  snapshotCity          String?
  snapshotLicenseNumber String?

  imageRightsConsent           Boolean @default(false)
  internalRulesAccepted        Boolean @default(false)
  emailCommunicationsConsent   Boolean @default(false)

  amountCents          Int
  duesAccountNumber    String
  /// DUE | PAID
  status               String
  paidAt               DateTime?
  treasuryAccountNumber String?
  entryId              String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, seasonId])
  @@index([associationId, seasonId, status])
  @@index([seasonId])
  @@index([tariffId])
  @@index([categoryId])
}

model Donation {
  id            String     @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  fiscalYearId  String
  fiscalYear    FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  donorName       String
  donorAddress    String?
  donorPostalCode String?
  donorCity       String?
  donorEmail      String?

  amountCents           Int
  date                  DateTime
  /// ESPECES | CHEQUE | VIREMENT | CB | AUTRE
  paymentMethod         String
  treasuryAccountNumber String
  eligibilityAttested   Boolean @default(false)

  entryId String? @unique
  taxReceipt TaxReceipt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, date])
  @@index([fiscalYearId, date])
}

model TaxReceiptSequence {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  calendarYear  Int
  nextNumber    Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([associationId, calendarYear])
}

model TaxReceipt {
  id            String      @id @default(uuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  donationId    String      @unique
  donation      Donation    @relation(fields: [donationId], references: [id], onDelete: Restrict)

  calendarYear Int
  sequence     Int
  number       String

  issuedAt     DateTime @default(now())
  cancelledAt  DateTime?
  pdfDocumentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([associationId, calendarYear, sequence])
  @@index([associationId, issuedAt])
}
